name: {{ .Name }}local
services:
{{- if .ShouldAddDb}}
  {{ .Name }}_postgres:
    image: postgres:17-alpine
    ports:
      - "5433:5432"
    environment:
      - POSTGRES_USER=postgres
      - POSTGRES_PASSWORD=postgres
      - POSTGRES_DB={{.Name}}
    volumes:
      - {{ .Name }}pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 5
{{- end}}
{{- if .ShouldAddRedis}}

  {{ .Name }}_redis:
    image: redis:8-alpine
    ports:
      - "6380:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 5
{{- end}}
{{- if .ShouldAddDb}}

volumes:
  {{ .Name }}pgdata:
{{- end}}
