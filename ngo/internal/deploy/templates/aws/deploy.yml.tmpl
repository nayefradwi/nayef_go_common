name: Deploy {{.Environment}}

on:
  workflow_dispatch:

concurrency:
  group: deploy-{{.Environment}}

permissions:
  id-token: write
  contents: read

jobs:
  deploy:
    name: Deploy
    runs-on: ubuntu-latest
    environment: {{.Environment}}
    timeout-minutes: 30
    env:
      AWS_REGION: ${{"{{"}} vars.AWS_REGION }}
      CLUSTER: {{.Name}}-{{.Environment}}
      SERVICE: {{.Name}}-{{.Environment}}

    steps:
      - uses: actions/checkout@v4

      - uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{"{{"}} vars.AWS_ROLE_ARN }}
          aws-region: ${{"{{"}} vars.AWS_REGION }}

      - id: ecr
        uses: aws-actions/amazon-ecr-login@v2

      - name: Build and push
        env:
          REGISTRY: ${{"{{"}} steps.ecr.outputs.registry }}
        run: |
          docker build -f build/Dockerfile -t "$REGISTRY/$SERVICE:$GITHUB_SHA" .
          docker push "$REGISTRY/$SERVICE:$GITHUB_SHA"
          echo "APP_IMAGE=$REGISTRY/$SERVICE:$GITHUB_SHA" >> "$GITHUB_ENV"
{{- if .HasPostgres}}

          docker build -f build/migrate.Dockerfile -t "$REGISTRY/$SERVICE-migrate:$GITHUB_SHA" .
          docker push "$REGISTRY/$SERVICE-migrate:$GITHUB_SHA"
          echo "MIGRATE_IMAGE=$REGISTRY/$SERVICE-migrate:$GITHUB_SHA" >> "$GITHUB_ENV"
{{- end}}

      - name: Register task definitions
        run: |
          register() {
            aws ecs describe-task-definition --task-definition "$1" --query taskDefinition |
              jq --arg image "$2" '.containerDefinitions[0].image = $image | del(.taskDefinitionArn, .revision, .status, .requiresAttributes, .compatibilities, .registeredAt, .registeredBy)' > task-definition.json
            aws ecs register-task-definition --cli-input-json file://task-definition.json --query taskDefinition.taskDefinitionArn --output text
          }

          echo "APP_TASK_DEFINITION=$(register "$SERVICE" "$APP_IMAGE")" >> "$GITHUB_ENV"
{{- if .HasPostgres}}
          echo "MIGRATE_TASK_DEFINITION=$(register "$SERVICE-migrate" "$MIGRATE_IMAGE")" >> "$GITHUB_ENV"

      - name: Migrate
        env:
          SUBNETS: ${{"{{"}} vars.AWS_PRIVATE_SUBNETS }}
          SECURITY_GROUP: ${{"{{"}} vars.AWS_APP_SECURITY_GROUP }}
        run: |
          task=$(aws ecs run-task --cluster "$CLUSTER" --launch-type FARGATE \
            --task-definition "$MIGRATE_TASK_DEFINITION" \
            --network-configuration "awsvpcConfiguration={subnets=[$SUBNETS],securityGroups=[$SECURITY_GROUP],assignPublicIp=DISABLED}" \
            --query 'tasks[0].taskArn' --output text)
          aws ecs wait tasks-stopped --cluster "$CLUSTER" --tasks "$task"

          code=$(aws ecs describe-tasks --cluster "$CLUSTER" --tasks "$task" --query 'tasks[0].containers[0].exitCode' --output text)
          if [ "$code" != "0" ]; then
            echo "migration failed with exit code $code, see the migrate stream in /ecs/$CLUSTER"
            exit 1
          fi
{{- end}}

      - name: Deploy
        run: |
          aws ecs update-service --cluster "$CLUSTER" --service "$SERVICE" --task-definition "$APP_TASK_DEFINITION" > /dev/null
          aws ecs wait services-stable --cluster "$CLUSTER" --services "$SERVICE"

          # the circuit breaker rolls a failed deploy back, which also ends up "stable"
          running=$(aws ecs describe-services --cluster "$CLUSTER" --services "$SERVICE" --query 'services[0].taskDefinition' --output text)
          if [ "$running" != "$APP_TASK_DEFINITION" ]; then
            echo "new tasks failed their health checks, ECS rolled back to $running"
            exit 1
          fi
