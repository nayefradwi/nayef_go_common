project_id  = "PROJECT_ID"
region      = "us-central1"
github_repo = "OWNER/REPO"
{{- if .IsSmall}}
zone        = "us-central1-a"

# valid for one hour: gh api -X POST repos/OWNER/REPO/actions/runners/registration-token --jq .token
github_runner_token = "CHANGE_ME"
ssh_public_key      = "ssh-ed25519 AAAA... you@host"
ssh_allowed_cidr    = "203.0.113.4/32"
{{- end}}
