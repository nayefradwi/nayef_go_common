name: Deploy {{.Environment}}

on:
  workflow_dispatch:

concurrency:
  group: deploy-{{.Environment}}

permissions:
  id-token: write
  contents: read

jobs:
  deploy:
    name: Deploy
    runs-on: ubuntu-latest
    environment: {{.Environment}}
    timeout-minutes: 30
    env:
      ACR_NAME: ${{"{{"}} vars.AZURE_ACR_NAME }}
      REGISTRY: ${{"{{"}} vars.AZURE_ACR_NAME }}.azurecr.io
      RESOURCE_GROUP: rg-{{.Name}}-{{.Environment}}
      APP: {{.Name}}-{{.Environment}}
      JOB: {{.Name}}-{{.Environment}}-migrate

    steps:
      - uses: actions/checkout@v4

      - uses: azure/login@v2
        with:
          client-id: ${{"{{"}} vars.AZURE_CLIENT_ID }}
          tenant-id: ${{"{{"}} vars.AZURE_TENANT_ID }}
          subscription-id: ${{"{{"}} vars.AZURE_SUBSCRIPTION_ID }}

      - name: Build and push
        run: |
          az acr login --name "$ACR_NAME"

          docker build -f build/Dockerfile -t "$REGISTRY/app:$GITHUB_SHA" .
          docker push "$REGISTRY/app:$GITHUB_SHA"
{{- if .HasPostgres}}

          docker build -f build/migrate.Dockerfile -t "$REGISTRY/migrate:$GITHUB_SHA" .
          docker push "$REGISTRY/migrate:$GITHUB_SHA"

      - name: Migrate
        run: |
          az config set extension.use_dynamic_install=yes_without_prompt
          az containerapp job update --name "$JOB" --resource-group "$RESOURCE_GROUP" --image "$REGISTRY/migrate:$GITHUB_SHA" --output none
          execution=$(az containerapp job start --name "$JOB" --resource-group "$RESOURCE_GROUP" --query name --output tsv)

          # the job's replica timeout bounds this loop
          while true; do
            status=$(az containerapp job execution show --name "$JOB" --resource-group "$RESOURCE_GROUP" \
              --job-execution-name "$execution" --query properties.status --output tsv)
            case "$status" in
            Succeeded) break ;;
            Failed | Stopped | Degraded)
              echo "migration $status, see execution $execution"
              exit 1
              ;;
            esac
            sleep 10
          done
{{- end}}

      # single revision mode keeps the old revision serving until the new one is ready
      - name: Deploy
        run: |
          az config set extension.use_dynamic_install=yes_without_prompt
          az containerapp update --name "$APP" --resource-group "$RESOURCE_GROUP" --image "$REGISTRY/app:$GITHUB_SHA" --output none
          latest=$(az containerapp show --name "$APP" --resource-group "$RESOURCE_GROUP" --query properties.latestRevisionName --output tsv)

          for _ in $(seq 30); do
            ready=$(az containerapp show --name "$APP" --resource-group "$RESOURCE_GROUP" --query properties.latestReadyRevisionName --output tsv)
            [ "$ready" = "$latest" ] && exit 0
            sleep 10
          done

          echo "revision $latest did not become ready, traffic stays on $ready"
          exit 1
