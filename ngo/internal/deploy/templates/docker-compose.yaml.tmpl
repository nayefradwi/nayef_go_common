name: {{.Name}}-{{.Environment}}

services:
  {{.Name}}:
    build:
      context: ../../
      dockerfile: build/Dockerfile
    env_file:
      - .env
{{- if or .HasPostgres .HasRedis}}
    depends_on:
{{- if .HasPostgres}}
      postgres:
        condition: service_healthy
      migrate:
        condition: service_completed_successfully
{{- end}}
{{- if .HasRedis}}
      redis:
        condition: service_healthy
{{- end}}
{{- end}}
    restart: unless-stopped
{{- if .HasPostgres}}

  migrate:
    build:
      context: ../../
      dockerfile: build/migrate.Dockerfile
    env_file:
      - .env
    depends_on:
      postgres:
        condition: service_healthy
    restart: "no"

  postgres:
    image: postgres:17-alpine
    environment:
      - POSTGRES_USER=${POSTGRES_USER}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_DB=${POSTGRES_DB}
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 5s
      timeout: 5s
      retries: 5
    restart: unless-stopped
{{- end}}
{{- if .HasRedis}}

  redis:
    image: redis:8-alpine
    command: ["redis-server", "--appendonly", "yes", "--maxmemory-policy", "noeviction"]
    volumes:
      - redisdata:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 5
    restart: unless-stopped
{{- end}}
{{- if .IsGrpc}}

  # cloudflare tunnels can't serve grpc on a public hostname, so caddy terminates tls on the box
  caddy:
    image: caddy:2-alpine
    ports:
      - "80:80"
      - "443:443"
    configs:
      - source: caddyfile
        target: /etc/caddy/Caddyfile
    volumes:
      - caddydata:/data
    depends_on:
      - {{.Name}}
    restart: unless-stopped
{{- else}}

  cloudflared:
    image: cloudflare/cloudflared:latest
    command: tunnel --no-autoupdate run
    environment:
      - TUNNEL_TOKEN=${TUNNEL_TOKEN}
    depends_on:
      - {{.Name}}
    restart: unless-stopped
{{- end}}
{{- if .IsGrpc}}

configs:
  caddyfile:
    content: |
      ${DOMAIN} {
        reverse_proxy h2c://{{.Name}}:4000
      }
{{- end}}
{{- if or .HasPostgres .HasRedis .IsGrpc}}

volumes:
{{- if .HasPostgres}}
  pgdata:
{{- end}}
{{- if .HasRedis}}
  redisdata:
{{- end}}
{{- if .IsGrpc}}
  caddydata:
{{- end}}
{{- end}}
