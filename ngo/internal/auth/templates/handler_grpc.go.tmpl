	return &authv1.SignupResponse{Tokens: toTokens(tokens)}, nil
}

func (h AuthHandler) Login(ctx context.Context, req *authv1.LoginRequest) (*authv1.LoginResponse, error) {
	res, err := h.svc.login(ctx, CredentialsRequest{ {{- .IdentifierField}}: req.{{.IdentifierField}}, Password: req.Password})
	if err != nil {
		return nil, err
	}
{{- if .Mfa}}

	return &authv1.LoginResponse{Tokens: toTokens(res.Tokens), MfaToken: res.MfaToken}, nil
{{- else}}

	return &authv1.LoginResponse{Tokens: toTokens(res)}, nil
{{- end}}
}

