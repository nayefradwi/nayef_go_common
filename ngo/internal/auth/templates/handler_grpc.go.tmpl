package auth

import (
	"context"

	"github.com/nayefradwi/nayef_go_common/auth"
	authv1 "{{.GoModule}}/gen/auth/v1"
	"{{.GoModule}}/gen/auth/v1/authv1connect"
)

var (
	_ authv1connect.AuthServiceHandler    = AuthHandler{}
	_ authv1connect.CodeServiceHandler    = AuthHandler{}
	_ authv1connect.AccountServiceHandler = AuthHandler{}
)

type AuthHandler struct {
	svc AuthService
}

func NewAuthHandler(svc AuthService) AuthHandler {
	return AuthHandler{
		svc: svc,
	}
}

// nil when the login is waiting on an MFA challenge
func toTokens(t auth.TokenDTO) *authv1.Tokens {
	if t.AccessToken == "" {
		return nil
	}

	return &authv1.Tokens{AccessToken: t.AccessToken, RefreshToken: t.RefreshToken}
}

func (h AuthHandler) Refresh(ctx context.Context, req *authv1.RefreshRequest) (*authv1.RefreshResponse, error) {
	tokens, err := h.svc.refresh(ctx, RefreshRequest{RefreshToken: req.RefreshToken})
	if err != nil {
		return nil, err
	}

	return &authv1.RefreshResponse{Tokens: toTokens(tokens)}, nil
}

func (h AuthHandler) Logout(ctx context.Context, req *authv1.LogoutRequest) (*authv1.LogoutResponse, error) {
	if err := h.svc.logout(ctx, RefreshRequest{RefreshToken: req.RefreshToken}); err != nil {
		return nil, err
	}

	return &authv1.LogoutResponse{}, nil
}

func (h AuthHandler) Me(ctx context.Context, req *authv1.MeRequest) (*authv1.MeResponse, error) {
	user, err := h.svc.me(ctx)
	if err != nil {
		return nil, err
	}

	return &authv1.MeResponse{Id: user.Id.String(), {{.IdentifierField}}: user.{{.IdentifierField}}}, nil
}

func (h AuthHandler) LogoutAll(ctx context.Context, req *authv1.LogoutAllRequest) (*authv1.LogoutAllResponse, error) {
	if err := h.svc.logoutAll(ctx); err != nil {
		return nil, err
	}

	return &authv1.LogoutAllResponse{}, nil
}
{{- if .Password}}

