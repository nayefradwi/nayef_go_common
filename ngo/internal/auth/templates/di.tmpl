{{- define "imports" -}}
{{- if .Mfa}}
"encoding/hex"
{{- end}}
{{- if not .Grpc}}
"net/http"
{{- end}}
"time"
{{- if .Grpc}}
"connectrpc.com/connect"
{{- end}}
"github.com/nayefradwi/nayef_go_common/auth"
"github.com/nayefradwi/nayef_go_common/auth/{{.StorePkg}}"
{{- if .Grpc}}
"github.com/nayefradwi/nayef_go_common/auth/authconnect"
{{- else}}
"github.com/nayefradwi/nayef_go_common/auth/authhttp"
{{- end}}
"github.com/nayefradwi/nayef_go_common/errors"
appauth "{{.GoModule}}/internal/auth"
{{- end -}}

{{- define "wiring" -}}
// every limit and TTL below is yours to change
sessionStore := errors.Must({{.StorePkg}}.NewSessionStore(di.{{.StoreDiField}}))
codeStore := errors.Must({{.StorePkg}}.NewCodeStore(di.{{.StoreDiField}}))
attemptStore := {{.StorePkg}}.NewAttemptStore(di.{{.StoreDiField}})
{{- if .Mfa}}
totpStore := errors.Must({{.StorePkg}}.NewTotpStore(di.{{.StoreDiField}}))
{{- end}}
{{- if .Jwt}}
// jwt access tokens are checked without a store read, so logout only ends the
// refresh token; access tokens already issued live until they expire
provider := auth.NewJwtTokenProvider(errors.Must(auth.NewJwtTokenProviderConfig(config.Auth.JwtSecret, 15*time.Minute, auth.AccessTokenType)))
sessions := errors.Must(auth.NewJwtSessionManager(sessionStore, provider, 30*24*time.Hour))
{{- else}}
// opaque access tokens are looked up on every request, so logout ends them at once
sessions := errors.Must(auth.NewOpaqueSessionManager(sessionStore, 15*time.Minute, 30*24*time.Hour))
{{- end}}
{{- if .Grpc}}
di.Authenticate = authconnect.{{if .Jwt}}NewJwtInterceptor(provider){{else}}NewOpaqueInterceptor(sessions){{end}}
di.AuthRateLimit = authconnect.RateLimit(errors.Must(auth.NewLimiter(attemptStore, 20, time.Hour)), authconnect.ByIP("codes"))
{{- else}}
di.Authenticate = authhttp.{{if .Jwt}}NewJwtMiddleware(provider){{else}}NewOpaqueMiddleware(sessions){{end}}.UseAuthentication
di.AuthRateLimit = authhttp.RateLimit(errors.Must(auth.NewLimiter(attemptStore, 20, time.Hour)), authhttp.ByIP("codes"))
{{- end}}
{{- if .Password}}
logins := errors.Must(auth.NewLimiter(attemptStore, 5, 15*time.Minute))
resets := errors.Must(auth.NewOneTimeTokenManager(codeStore, auth.CodeLimits{
	TTL: 30 * time.Minute, ResendAfter: time.Minute, MaxSends: 3, MaxAttempts: 5,
}))
{{- end}}
{{- if .Otp}}
codes := errors.Must(auth.NewOtpManager(codeStore, auth.OtpConfig{
	Secret:     []byte(config.Auth.OtpSecret),
	Length:     6,
	CodeLimits: auth.CodeLimits{TTL: 10 * time.Minute, ResendAfter: time.Minute, MaxSends: 5, MaxAttempts: 5},
}))
{{- end}}
{{- if .Mfa}}
totp := errors.Must(auth.NewTotpManager(totpStore, auth.TotpConfig{
	Key:    errors.Must(hex.DecodeString(config.Auth.TotpKey)),
	Issuer: "{{.ProjectName}}",
}))
// MaxAttempts caps code guesses per login; MaxSends caps logins per TTL
pending := errors.Must(auth.NewOneTimeTokenManager(codeStore, auth.CodeLimits{
	TTL: 5 * time.Minute, ResendAfter: 0, MaxSends: 5, MaxAttempts: 5,
}))
{{- end}}
di.Auth = appauth.NewAuthService(di.Pool, sessions
{{- if .Password}}, logins, resets, auth.DefaultPasswordPolicy, auth.DefaultHashingConfig{{end}}
{{- if .Otp}}, codes{{end}}
{{- if .Mfa}}, totp, pending{{end -}}
)
{{- end -}}
